<Window x:Class="ConfJoystick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConfJoystick" Height="450" Width="490"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu bar + inline status.
             The status area is a WrapPanel: the window has a fixed width, so with three config
             names on one line the right-most ones were pushed outside the visible area. Wrapping
             puts whatever does not fit onto a further row instead. Each label/value pair is its
             own StackPanel so a name never wraps away from its label. -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="True"
                   Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Top">
                <MenuItem Header="_Options">
                    <MenuItem Header="_Reload Config" Click="ReloadConfig_Click"/>
                    <MenuItem Header="_Save" Click="SaveAll_Click"/>
                    <Separator/>
                    <MenuItem Header="_Load Lever Config..."   Click="LoadLeverConfig_Click"/>
                    <MenuItem Header="Save Lever Config _As..." Click="SaveLeverConfigAs_Click"/>
                    <Separator/>
                    <MenuItem Header="Load _Button Config..."  Click="LoadButtonConfig_Click"/>
                    <MenuItem Header="Save Button Config As..." Click="SaveButtonConfigAs_Click"/>
                    <Separator/>
                    <MenuItem Header="Load _FFB Config..." Click="LoadFfbConfig_Click"/>
                    <Separator/>
                    <MenuItem Header="Change Config _Directory..." Click="ChangeConfigDir_Click"/>
                    <Separator/>
                    <MenuItem Header="Configure _Keys..." Click="ButtonMappingButton_Click"/>
                </MenuItem>
            </Menu>
            <WrapPanel Orientation="Horizontal" Margin="6,3,6,3">
                <WrapPanel.Resources>
                    <!-- Config names can be long; trim rather than force an extra row, and
                         show the full name on hover. -->
                    <Style x:Key="ConfigName" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="#FF555555"/>
                        <Setter Property="MaxWidth" Value="170"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip"
                                Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Style>
                    <Style x:Key="ConfigLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="#FF555555"/>
                    </Style>
                </WrapPanel.Resources>

                <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Margin="0,1,14,1"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,1,12,1">
                    <TextBlock Text="Lever: " Style="{StaticResource ConfigLabel}"/>
                    <TextBlock x:Name="LeverFileText" Text="—" Style="{StaticResource ConfigName}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1,12,1">
                    <TextBlock Text="Button: " Style="{StaticResource ConfigLabel}"/>
                    <TextBlock x:Name="ButtonFileText" Text="—" Style="{StaticResource ConfigName}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                    <TextBlock Text="FFB: " Style="{StaticResource ConfigLabel}"/>
                    <TextBlock x:Name="FfbFileText" Text="—" Style="{StaticResource ConfigName}"/>
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Joystick Selection -->
            <GroupBox Grid.Row="0" Header="Joystick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="JoystickComboBox"
                              SelectionChanged="JoystickComboBox_SelectionChanged"
                              VerticalAlignment="Center" Height="26"/>
                    <Button Grid.Column="1" Content="Refresh"
                            Click="RefreshButton_Click"
                            Width="70" Height="26" Margin="8,0,0,0"/>
                </Grid>
            </GroupBox>

            <!-- Axis Monitor -->
            <GroupBox Grid.Row="1" Header="Axis Monitor">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Axis:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" x:Name="AxisComboBox"
                              SelectionChanged="AxisComboBox_SelectionChanged"
                              VerticalAlignment="Center" Height="26"/>
                    <TextBlock Grid.Column="2" Text="Current Value:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBlock Grid.Column="3" x:Name="AxisValueText" Text="---"
                               VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                </Grid>
            </GroupBox>

            <!-- Emulation Toggle - most important control -->
            <Button Grid.Row="2"
                    x:Name="ToggleEmulationButton"
                    Content="START EMULATION"
                    Click="ToggleEmulationButton_Click"
                    FontSize="18" FontWeight="Bold"
                    Height="70" Margin="0,0,0,8"
                    Background="#FF4CAF50" Foreground="White"
                    BorderThickness="0"/>

            <!-- Verification -->
            <GroupBox Grid.Row="3" Header="Verification">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             x:Name="VerificationTextBox"
                             TextChanged="VerificationTextBox_TextChanged"
                             Height="28" VerticalContentAlignment="Center"
                             FontFamily="Consolas"/>
                    <TextBlock Grid.Column="1"
                               x:Name="CharCountText"
                               Text="Chars: 0"
                               VerticalAlignment="Center"
                               Margin="10,0,8,0" FontSize="11"/>
                    <Button Grid.Column="2"
                            Content="Clear"
                            Click="ClearVerificationButton_Click"
                            Width="50" Height="28"/>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
