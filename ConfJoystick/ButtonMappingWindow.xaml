<Window x:Class="ConfJoystick.ButtonMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Button → Key Mapping" Height="420" Width="500"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="237*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- State status -->
        <Border Grid.Row="0" Margin="-1,3,1,5"
                Background="#FFEEF2FF" BorderBrush="#FF9FA8DA"
                BorderThickness="1" CornerRadius="3" Padding="12,8">
            <TextBlock x:Name="StatusText"
                       Text="Opening joysticks..."
                       FontSize="13" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <ComboBox x:Name="JoystickComboBox"
          SelectionChanged="JoystickComboBox_SelectionChanged" Margin="-1,43,1,67" Grid.RowSpan="3" />

        <!-- Live assignment preview -->
        <TextBlock Grid.Row="2"
                   x:Name="AssignmentText"
                   Text=""
                   FontSize="12" Margin="1,38,1,27"
                   Foreground="#FF222222"/>

        <!-- Mappings list -->
        <GroupBox Grid.Row="2" Header="Mappings" Padding="4" Margin="0,68,0,0" Grid.RowSpan="2">
            <ListView x:Name="MappingList" IsTabStop="False" BorderThickness="0" Height="265">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Joystick"   Width="160"
                                        DisplayMemberBinding="{Binding JoystickLabel}"/>
                        <GridViewColumn Header="Button"     Width="65"
                                        DisplayMemberBinding="{Binding ButtonLabel}"/>
                        <GridViewColumn Header="Key / Combo" Width="220"
                                        DisplayMemberBinding="{Binding KeyLabel}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <!-- Keyboard legend -->
        <TextBlock Grid.Row="3"
                   Text="Enter = Confirm    Backspace = Go back    Esc = Close"
                   FontSize="10" Foreground="#FF888888"
                   HorizontalAlignment="Center" Margin="0,181,0,29"/>
    </Grid>
</Window>
